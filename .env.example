# Copy this file to .env and fill in values as needed.
# Nothing in this file is required to run the system: defaults use a local
# Hugging Face model for generation and no external API keys at all.

# ---------------------------------------------------------------------------
# LLM provider: "local" (default, no key needed) or "openai" (OpenAI-compatible)
# ---------------------------------------------------------------------------
LLM_PROVIDER=local

# Used only when LLM_PROVIDER=local
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Used only when LLM_PROVIDER=openai. OPENAI_BASE_URL can point at any
# OpenAI-compatible endpoint (OpenAI itself, Azure OpenAI gateway, a local
# vLLM/Ollama OpenAI-compatible server, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Retrieval / embedding models (all configurable; these are the shipped defaults)
# ---------------------------------------------------------------------------
DENSE_EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
DENSE_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# ---------------------------------------------------------------------------
# Hybrid fusion / retrieval sizing
# ---------------------------------------------------------------------------
HYBRID_ALPHA=0.5
FUSION_METHOD=weighted
BM25_CANDIDATE_K=20
DENSE_CANDIDATE_K=20
RERANK_TOP_K=5

# ---------------------------------------------------------------------------
# Reliability gate behavior: "flag" (default, keep + mark) or "remove"/"rewrite"
# ---------------------------------------------------------------------------
RELIABILITY_GATE_MODE=flag

# Contact address for NCBI E-utilities (required by NCBI usage policy)
NCBI_CONTACT_EMAIL=research-prototype@example.com
